{
  "name": "timestage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chronometre de scene : fenetre de controle, fenetre d'affichage, partage par QR code, messages, questions du public et mode hors ligne.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "build:static": "node scripts/build-static.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "test:worker": "node scripts/build-worker.mjs && node --test test/cloudflare/worker.test.js",
    "cf:dev": "npm run build:worker && wrangler dev",
    "cf:deploy": "npm run build:worker && wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "author": "Arnisound Tools (Theo Arnissolle) <contact@arnisoundtools.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/arnisound/TIMESTAGE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnisound/TIMESTAGE.git"
  },
  "bugs": {
    "email": "contact@arnisoundtools.com"
  },
  "devDependencies": {
    "wrangler": "^4.137.0"
  }
}
